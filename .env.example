# Copy this file to .env and fill in your values.
# Never commit .env to git.

# OpenAI: GPT-4o story drafting and gpt-image-1 still/source images.
OPENAI_API_KEY=sk-...

# Google Cloud Text-to-Speech: narration audio.
# Point to your JSON service account key file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-tts-key.json

# Fal.ai: animated Wan 2.5 text-to-video clips.
# Required only for --video-mode animated.
FAL_KEY=...
