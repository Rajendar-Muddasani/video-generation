# Copy this file to .env and fill in your values
# Never commit .env to git

# OpenAI — DALL-E 3 image generation (~$0.08 per image, ~$0.80 per story)
OPENAI_API_KEY=sk-...

# Google Cloud TTS — voice narration
# Point to your JSON service account key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-tts-key.json
